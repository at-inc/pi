{
	"name": "@at-inc/pi-ai-rs",
	"version": "1.5.0",
	"description": "@at-inc/pi-ai backed by the pi Rust core: the same exports and module layout, runtime in wasm, types from @at-inc/pi-ai",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./bun-oauth": {
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "node ../scripts/build-facade.mjs @at-inc/pi-ai ../../../packages/ai",
		"test:vitest": "node ../../../node_modules/vitest/vitest.mjs --run --config vitest.config.ts",
		"test:workers": "node test/workers/smoke.ts && node test/workers/listen.ts",
		"bench": "node --conditions=source bench/stream.ts"
	},
	"dependencies": {
		"@at-inc/pi-core": "1.5.0"
	},
	"peerDependencies": {
		"@at-inc/pi-ai": "1.5.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/at-inc/pi.git",
		"directory": "rust/npm/pi-ai"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}
